APP_MODE=training
HOST=0.0.0.0
PORT=4173
DATA_DIR=./data
BACKUP_DIR=./data/backups
TLS_CERT=./certs/server.pem
TLS_KEY=./certs/server-key.pem
PAYMENT_ADAPTER=simulator
FISCAL_ADAPTER=simulator
PRINT_ADAPTER=preview
SESSION_COOKIE_NAME=lagustosa_session

# Softpay sandbox uses a NEW, separate database. See PAYMENT-INTEGRATION.md.
# PAYMENT_ADAPTER=softpay-sandbox
# SOFTPAY_SANDBOX_CLIENT_ID=
# SOFTPAY_SANDBOX_CLIENT_SECRET=
# SOFTPAY_SANDBOX_MERCHANT_REFERENCE=
# SOFTPAY_SANDBOX_TERMINALS_FILE=

# Separate development-only fiskaly TEST tools; never activates the POS adapter.
# See server/fiskaly-test/README.md. No keys belong in frontend environment variables.
# FISKALY_TEST_API_KEY=
# FISKALY_TEST_API_SECRET=
# FISKALY_TEST_UNIT_ID=
# FISKALY_TEST_BINDINGS=[]
