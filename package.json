{
  "name": "lagustosa-kassa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --out-dir dist/server --platform node --target node24 --external better-sqlite3",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:safe-env": "node scripts/smoke-safe-test.mjs",
    "measure:availability": "node scripts/measure-availability.mjs",
    "start:safe-test": "node scripts/safe-test.mjs start",
    "check": "tsc --noEmit",
    "certs": "node scripts/create-certs.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "10.1.6",
    "@peculiar/x509": "2.1.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "^17.2.0",
    "fastify": "5.12.5",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.0"
  },
  "overrides": { "esbuild": "0.28.2" },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
